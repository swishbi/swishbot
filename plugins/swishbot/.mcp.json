{
  "mcpServers": {
    "dbt": {
      "command": "uvx",
      "args": ["--env-file", ".env", "dbt-mcp"]
    },
    "dagster-dg-cli": {
      "command": "dg",
      "args": ["mcp", "serve"]
    },
    "dlt": {
      "command": "uv",
      "args": ["run", "--with", "dlt-mcp[search]>=0.2.0,<1.0", "python", "-m", "dlt_mcp"]
    },
    "powerbi-remote": {
      "type": "http",
      "url": "https://api.fabric.microsoft.com/v1/mcp/powerbi",
      "_comment": "Requires Power BI admin to enable the MCP tenant setting."
    }
  }
}
