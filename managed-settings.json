{
  "cleanupPeriodDays": 30,
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "linear@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "powerbi-authoring@fabric-collection": true,
    "pyright-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "slack@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "extraKnownMarketplaces": {
    "fabric-collection": {
      "source": {
        "source": "github",
        "repo": "microsoft/skills-for-fabric"
      }
    }
  },
  "permissions": {
    "allow": [
      "Read(**/.env.example)",
      "Edit(**/.env.example)",
      "Bash(git *)",
      "WebSearch",
      "WebFetch",
      "mcp__claude_ai_Linear__*",
      "mcp__claude_ai_Slack__*",
      "mcp__plugin_github_github__*",
      "mcp__plugin_context7_context7__*",
      "mcp__plugin_swishbot_dbt__*",
      "mcp__plugin_swishbot_dlt__*",
      "mcp__plugin_swishbot_dagster-dg-cli__*",
      "mcp__plugin_swishbot_powerbi-remote__*",
      "mcp__plugin_powerbi-authoring_powerbi-modeling-mcp__*"
    ],
    "ask": [
      "mcp__claude_ai_Linear__delete_comment",
      "mcp__claude_ai_Linear__delete_attachment",
      "mcp__claude_ai_Linear__delete_status_update",
      "mcp__claude_ai_Slack__slack_create_canvas",
      "mcp__claude_ai_Slack__slack_update_canvas",
      "mcp__plugin_github_github__merge_pull_request",
      "mcp__plugin_github_github__delete_file",
      "mcp__plugin_github_github__actions_run_trigger",
      "mcp__plugin_github_github__fork_repository",
      "Read(**/.kube/config)",
      "Read(**/kubeconfig*)",
      "Read(**/*.tfvars)",
      "Read(**/.terraform/**)",
      "Read(**/*.azureauth)",
      "Read(**/appsettings*.json)",
      "Read(**/.npmrc)",
      "Read(**/pip.conf)",
      "Read(**/.gitconfig)"
    ],
    "deny": [
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *--delete*)",
      "Bash(git clean *-f*)",
      "Bash(git reflog expire*)",
      "Bash(git filter-branch*)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(git clone *)",
      "Read(~/.ssh/**)",
      "Bash(cat *.ssh*)",
      "Bash(cat *id_ed25519*)",
      "Bash(cat *id_rsa*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "docker",
      "docker-compose"
    ],
    "failIfUnavailable": true,
    "filesystem": {
      "allowRead": [
        "**/.env.example",
        "~/.ssh/known_hosts",
        "~/.ssh/known_hosts2",
        "~/.ssh/config"
      ],
      "allowWrite": [
        ".",
        "/tmp",
        "**/.env.example",
        "~/.ssh/known_hosts",
        "~/.ssh/known_hosts2"
      ],
      "denyRead": [
        "~/.azure",
        "~/.aws",
        "~/.ssh/id_*",
        "~/.ssh/*_rsa",
        "~/.ssh/*_ed25519",
        "~/.ssh/*_ecdsa",
        "~/.ssh/*_dsa",
        "~/.ssh/identity",
        "~/.dbt",
        "~/.config/gcloud",
        "~/.kube",
        "~/.netrc",
        "~/.pgpass",
        "~/.my.cnf",
        "~/.git-credentials",
        "~/.pypirc",
        "~/.npmrc",
        "**/.env",
        "**/.env.*",
        "**/.envrc",
        "**/*.pem",
        "**/*.key",
        "**/*.pfx",
        "**/*.p12",
        "**/*.jks",
        "**/secrets/**",
        "**/credentials/**",
        "**/service_account*.json",
        "**/*credential*.json",
        "**/accessTokens.json",
        "**/azureProfile.json",
        "**/TokenCache.dat",
        "**/AzureRmContext.json",
        "**/service-principal.json",
        "**/.dbt/profiles.yml",
        "**/.dlt/secrets.toml",
        "**/secrets.toml",
        "**/*.pbix",
        "**/*.pbit"
      ],
      "denyWrite": [
        "~/.azure",
        "~/.aws",
        "~/.ssh",
        "~/.dbt",
        "~/.config/gcloud",
        "~/.kube",
        "~/.bashrc",
        "~/.zshrc",
        "~/.bash_profile",
        "~/.profile"
      ]
    }
  }
}