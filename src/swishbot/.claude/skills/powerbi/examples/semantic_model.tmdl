				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI MAT (364)' =

					IF (
					    [ShowValueForDates],
					    VAR LastDayMAT = MAX ( DimDate[Sequential Day Number] )
					    VAR FirstDayMAT = LastDayMAT - 363
					    VAR Result =
					        CALCULATE (
					            [KPI],
					            ALLEXCEPT (
					                DimDate,
					                DimDate[Day Of Week Name],
					                DimDate[Day Of Week Name Short]
					            ),
					            DimDate[Sequential Day Number] >= FirstDayMAT
					                && DimDate[Sequential Day Number] <= LastDayMAT
					        )
					    RETURN
					        Result
					)
				displayFolder: Time Intelligence\Moving annual total growth
				lineageTag: e4c5342b-ff3f-4067-a019-66a0e26cfecb

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI PYMAT (364)' =

					IF (
					    [ShowValueForDates],
					    VAR LastDayAvailable = MAX ( DimDate[Sequential Day Number] )
					    VAR LastDayMAT = LastDayAvailable - 364
					    VAR FirstDayMAT = LastDayMAT - 363
					    VAR Result =
					        CALCULATE (
					            [KPI],
					            ALLEXCEPT (
					                DimDate,
					                DimDate[Day Of Week Name],
					                DimDate[Day Of Week Name Short]
					            ),
					            DimDate[Sequential Day Number] >= FirstDayMAT
					                && DimDate[Sequential Day Number] <= LastDayMAT
					        )
					    RETURN
					        Result
					)
				displayFolder: Time Intelligence\Moving annual total growth
