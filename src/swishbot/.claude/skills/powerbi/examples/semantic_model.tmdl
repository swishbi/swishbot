			partition _PrmPeriodHierarchy = calculated
				mode: import
				source =
						{
						    ("Year", NAMEOF('DimDate'[Year Number]), 0, "Y"),
						    ("Quarter", NAMEOF('DimDate'[Quarter Year Name]), 1, "Q"),
						    ("Month", NAMEOF('DimDate'[Accounting Period Name]), 2, "M")
						}

		table _Measures
			lineageTag: 588e760c-2691-436c-876d-a2fb0445fc47

			measure 'KPI PoP Highlight' = ```

					VAR _red = "#D64550"
					VAR _green = "#1AAB40"
					VAR _value = [KPI PoP]
					VAR VarianceGreaterthan0 =
					    IF ( _value >= 0, _green )
					VAR VarianceLessthan0 =
					    IF ( _value < 0, _red )
					RETURN
					    COALESCE ( VarianceGreaterthan0, VarianceLessthan0, "#000000" )

					```
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: 68cbe37a-8b7a-4464-a96f-fdbbb3d4b2a2

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI YoY %' =

					DIVIDE ( [KPI YoY], [KPI PY] )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: 88b446aa-ec5a-465d-a5ff-2f914c4bff6d

			measure 'KPI PY' =

					IF (
					    [ShowValueForDates],
					    SUMX (
					        VALUES ( DimDate[Fiscal Year Number] ),
					        VAR CurrentFiscalYearNumber = DimDate[Fiscal Year Number]
					        VAR DaysSelected =
					            CALCULATETABLE (
					                VALUES ( DimDate[Fiscal Day Of Year] ),
					                REMOVEFILTERS (
					                    DimDate[Day Of Week Name],
					                    DimDate[Day Of Week Name Short],
					                    DimDate[Day Of Week Iso]
					                ),
					                DimDate[DateWithSales] = TRUE
					            )
					        RETURN
					            CALCULATE (
					                [KPI],
					                DimDate[Fiscal Year Number] = CurrentFiscalYearNumber - 1,
					                DaysSelected,
					                ALLEXCEPT (
					                    DimDate,
					                    DimDate[Day Of Week Name],
					                    DimDate[Day Of Week Name Short]
					                )
					            )
					    )
					)
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: c9780fc5-5d19-4551-9322-3eedc3e7e5f6

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI YoY' =

					VAR ValueCurrentPeriod = [KPI]
					VAR ValuePreviousPeriod = [KPI PY]
					VAR Result =
					    IF (
					        NOT ISBLANK ( ValueCurrentPeriod )
					            && NOT ISBLANK ( ValuePreviousPeriod ),
					        ValueCurrentPeriod - ValuePreviousPeriod
					    )
					RETURN
					    Result
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: 8ef8a2e7-0076-4f60-82f4-4fe074b7c16d

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI PQ' =

					IF (
					    [ShowValueForDates],
					    SUMX (
					        VALUES ( DimDate[Fiscal Year Quarter Number] ),
					        VAR CurrentFiscalYearQuarterNumber = DimDate[Fiscal Year Quarter Number]
					        VAR DaysSelected =
					            CALCULATETABLE (
					                VALUES ( DimDate[Fiscal Day Of Quarter] ),
					                REMOVEFILTERS (
					                    DimDate[Day Of Week Name],
					                    DimDate[Day Of Week Name Short],
					                    DimDate[Day Of Week Iso]
					                ),
					                DimDate[DateWithSales] = TRUE
					            )
					        RETURN
					            CALCULATE (
					                [KPI],
					                DimDate[Fiscal Year Quarter Number] = CurrentFiscalYearQuarterNumber - 1,
					                DaysSelected,
					                ALLEXCEPT (
					                    DimDate,
					                    DimDate[Day Of Week Name],
					                    DimDate[Day Of Week Name Short]
					                )
					            )
					    )
					)
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: f043b357-ddc3-47e9-85f2-94800adfbf1a

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI QoQ' =

