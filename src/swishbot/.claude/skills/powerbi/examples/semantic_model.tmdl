		table _PrmDimension
			lineageTag: ebb52a5a-5aea-4217-b694-ec7ff426e3e5

			column Dimension
				lineageTag: 35c71501-0ab7-4d1b-9071-ac8b1a039139
				summarizeBy: none
				sourceColumn: [Value1]
				sortByColumn: '_PrmDimension Order'

				relatedColumnDetails
					groupByColumn: '_PrmDimension Fields'

				annotation SummarizationSetBy = Automatic

			column '_PrmDimension Fields'
				isHidden
				lineageTag: 263f3da0-69a7-4eb7-bd2e-4be61cc9dc8b
				summarizeBy: none
				sourceColumn: [Value2]
				sortByColumn: '_PrmDimension Order'

				extendedProperty ParameterMetadata = {"version":3,"kind":2}

				annotation SummarizationSetBy = Automatic

			column '_PrmDimension Order'
				isHidden
				formatString: 0
				lineageTag: c7eb7629-7dd3-4908-8fb1-41a5b5f056d2
				summarizeBy: sum
				sourceColumn: [Value3]

				annotation SummarizationSetBy = Automatic

			partition _PrmDimension = calculated
				mode: import
				source = ```
						{
						    // Company & Location context
						    ("Company", NAMEOF('DimCompany'[Company Name]), 0),
						    ("Parent Company", NAMEOF('DimCompany'[Parent Company Name]), 1),
						    ("Region", NAMEOF('DimCompany'[Region]), 2),

						    // Customer context
						    ("Customer", NAMEOF('DimCustomer'[Customer Name]), 3),
						    ("Customer Segment", NAMEOF('DimCustomer'[Segment]), 4),
						    ("Customer City", NAMEOF('DimCustomer'[City]), 5),
						    ("Customer State", NAMEOF('DimCustomer'[State]), 6),

						    // Product context
						    ("Product", NAMEOF('DimProduct'[Product Name]), 7),
						    ("Product Category", NAMEOF('DimProduct'[Category]), 8),
						    ("Product Subcategory", NAMEOF('DimProduct'[Subcategory]), 9)
						}

						```

		table _PrmKPI
			lineageTag: 74f0666c-9592-4b64-8649-6f7d35969485

			column KPI
				lineageTag: 59e8dd99-7cfc-4927-8351-44542778de8c
				summarizeBy: none
				sourceColumn: [Value1]
				sortByColumn: '_PrmKPI Order'

				relatedColumnDetails
					groupByColumn: '_PrmKPI Fields'

				annotation SummarizationSetBy = Automatic

			column '_PrmKPI Fields'
				isHidden
				lineageTag: 03039c59-4985-4e72-ac80-a2114182a974
				summarizeBy: none
				sourceColumn: [Value2]
				sortByColumn: '_PrmKPI Order'

				extendedProperty ParameterMetadata = {"version":3,"kind":2}

				annotation SummarizationSetBy = Automatic

			column '_PrmKPI Order'
				isHidden
				formatString: 0
				lineageTag: d9ae0f03-76e7-41f7-8ea5-dc97f287b4d9
				summarizeBy: sum
				sourceColumn: [Value3]

				annotation SummarizationSetBy = Automatic

			column 'KPI Category'
				lineageTag: 57224576-f946-4f59-8b8d-7a43119259a7
				summarizeBy: none
				sourceColumn: [Value4]
				sortByColumn: 'KPI Category Order'

				annotation SummarizationSetBy = Automatic

			column 'KPI Category Order'
				isHidden
				formatString: 0
				lineageTag: b03d53a1-2307-46f2-8bd5-0f15eb5b9835
				summarizeBy: sum
				sourceColumn: [Value5]

				annotation SummarizationSetBy = Automatic

			partition _PrmKPI = calculated
				mode: import
				source = ```
						{
						    // Revenue
						    ("Total Revenue", NAMEOF('_Measures'[Total Revenue]), 0, "Revenue", 0),
						    ("Average Order Value", NAMEOF('_Measures'[Average Order Value]), 1, "Revenue", 0),
						    ("Average Daily Revenue", NAMEOF('_Measures'[Average Daily Revenue]), 2, "Revenue", 0),

						    // Orders
						    ("Order Count", NAMEOF('_Measures'[Order Count]), 3, "Orders", 1),
						    ("Units Sold", NAMEOF('_Measures'[Units Sold]), 4, "Orders", 1),

						    // Customers
						    ("Active Customer Count", NAMEOF('_Measures'[Active Customer Count]), 5, "Customers", 2),
						    ("New Customer Count", NAMEOF('_Measures'[New Customer Count]), 6, "Customers", 2),
						    ("Customer Retention Rate", NAMEOF('_Measures'[Customer Retention Rate]), 7, "Customers", 2),

						    // Profitability
						    ("Gross Profit", NAMEOF('_Measures'[Gross Profit]), 8, "Profitability", 3),
						    ("Gross Margin %", NAMEOF('_Measures'[Gross Margin %]), 9, "Profitability", 3),
						    ("Net Profit", NAMEOF('_Measures'[Net Profit]), 10, "Profitability", 3),
						    ("Net Margin %", NAMEOF('_Measures'[Net Margin %]), 11, "Profitability", 3)
						}

						```

