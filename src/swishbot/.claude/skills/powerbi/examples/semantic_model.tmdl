			measure 'KPI PW' =

					IF (
					    [ShowValueForDates],
					    SUMX (
					        VALUES ( DimDate[Fiscal Year Week Number] ),
					        VAR CurrentFiscalYearWeekNumber = DimDate[Fiscal Year Week Number]
					        VAR DaysSelected =
					            CALCULATETABLE (
					                VALUES ( DimDate[Day Of Week Iso] ),
					                REMOVEFILTERS (
					                    DimDate[Day Of Week Name],
					                    DimDate[Day Of Week Name Short],
					                    DimDate[Day Of Week Iso]
					                ),
					                DimDate[DateWithSales] = TRUE
					            )
					        RETURN
					            CALCULATE (
					                [KPI],
					                DimDate[Fiscal Year Week Number] = CurrentFiscalYearWeekNumber - 1,
					                KEEPFILTERS ( DaysSelected ),
					                ALLEXCEPT (
					                    DimDate,
