		table _CalcTimeIntelligence
			lineageTag: 9d64aa1c-02fd-457f-b3fa-de2dae56e9bf

			calculationGroup
				precedence: 4

				calculationItem CY = SELECTEDMEASURE ()

				calculationItem PY =
						IF (
						    [ShowValueForDates],
						    SUMX (
						        VALUES ( DimDate[Fiscal Year Number] ),
						        VAR CurrentFiscalYearNumber = DimDate[Fiscal Year Number]
						        VAR DaysSelected =
						            CALCULATETABLE (
						                VALUES ( DimDate[Fiscal Day Of Year] ),
						                REMOVEFILTERS (
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short],
						                    DimDate[Day Of Week Iso]
						                ),
						                DimDate[DateWithSales] = TRUE
						            )
						        RETURN
						            CALCULATE (
						                SELECTEDMEASURE (),
						                DimDate[Fiscal Year Number] = CurrentFiscalYearNumber - 1,
						                DaysSelected,
						                ALLEXCEPT (
						                    DimDate,
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short]
						                )
						            )
						    )
						)

				calculationItem YoY =
						VAR ValueCurrentPeriod =
						    SELECTEDMEASURE ()
						VAR ValuePreviousPeriod =
						    IF (
						        [ShowValueForDates],
						        SUMX (
						            VALUES ( DimDate[Fiscal Year Number] ),
						            VAR CurrentFiscalYearNumber = DimDate[Fiscal Year Number]
						            VAR DaysSelected =
						                CALCULATETABLE (
						                    VALUES ( DimDate[Fiscal Day Of Year] ),
						                    REMOVEFILTERS (
						                        DimDate[Day Of Week Name],
						                        DimDate[Day Of Week Name Short],
						                        DimDate[Day Of Week Iso]
						                    ),
						                    DimDate[DateWithSales] = TRUE
						                )
						            RETURN
						                CALCULATE (
						                    SELECTEDMEASURE (),
						                    DimDate[Fiscal Year Number] = CurrentFiscalYearNumber - 1,
						                    DaysSelected,
						                    ALLEXCEPT (
						                        DimDate,
						                        DimDate[Day Of Week Name],
						                        DimDate[Day Of Week Name Short]
						                    )
						                )
						        )
						    )
						VAR Result =
						    IF (
						        NOT ISBLANK ( ValueCurrentPeriod ) && NOT ISBLANK ( ValuePreviousPeriod ),
						        ValueCurrentPeriod - ValuePreviousPeriod
						    )
						RETURN
						    Result

				calculationItem 'YoY %' =
						VAR ValueCurrentPeriod =
						    SELECTEDMEASURE ()
						VAR ValuePreviousPeriod =
						    IF (
						        [ShowValueForDates],
						        SUMX (
						            VALUES ( DimDate[Fiscal Year Number] ),
						            VAR CurrentFiscalYearNumber = DimDate[Fiscal Year Number]
						            VAR DaysSelected =
						                CALCULATETABLE (
						                    VALUES ( DimDate[Fiscal Day Of Year] ),
						                    REMOVEFILTERS (
						                        DimDate[Day Of Week Name],
						                        DimDate[Day Of Week Name Short],
						                        DimDate[Day Of Week Iso]
						                    ),
						                    DimDate[DateWithSales] = TRUE
						                )
						            RETURN
						                CALCULATE (
						                    SELECTEDMEASURE (),
						                    DimDate[Fiscal Year Number] = CurrentFiscalYearNumber - 1,
						                    DaysSelected,
						                    ALLEXCEPT (
						                        DimDate,
						                        DimDate[Day Of Week Name],
						                        DimDate[Day Of Week Name Short]
						                    )
						                )
						        )
						    )
						VAR Result =
						    IF (
						        NOT ISBLANK ( ValueCurrentPeriod ) && NOT ISBLANK ( ValuePreviousPeriod ),
						        DIVIDE ( ValueCurrentPeriod - ValuePreviousPeriod, ABS ( ValuePreviousPeriod ) )
						    )
						RETURN
						    Result

					formatStringDefinition = "0.0%"

				calculationItem YTD =
						IF (
						    [ShowValueForDates],
						    VAR LastDayAvailable =
						        MAX ( DimDate[Fiscal Day Of Year] )
						    VAR LastFiscalYearAvailable =
						        MAX ( DimDate[Fiscal Year Number] )
						    VAR Result =
						        CALCULATE (
						            SELECTEDMEASURE (),
						            ALLEXCEPT (
						                DimDate,
						                DimDate[Day Of Week Name],
						                DimDate[Day Of Week Name Short]
						            ),
						            DimDate[Fiscal Day Of Year] <= LastDayAvailable,
						            DimDate[Fiscal Year Number] = LastFiscalYearAvailable
						        )
						    RETURN
						        Result
						)

				calculationItem PYTD =
						IF (
						    [ShowValueForDates],
						    VAR PreviousFiscalYear =
						        MAX ( DimDate[Fiscal Year Number] ) - 1
						    VAR LastDayOfFiscalYearAvailable =
						        CALCULATE (
						            MAX ( DimDate[Fiscal Day Of Year] ),
						            REMOVEFILTERS (
						                DimDate[Day Of Week Name],
						                DimDate[Day Of Week Name Short],
						                DimDate[Day Of Week Iso]
						            ),
						            DimDate[DateWithSales] = TRUE
						        )
						    VAR Result =
						        CALCULATE (
						            SELECTEDMEASURE (),
						            ALLEXCEPT (
						                DimDate,
						                DimDate[Day Of Week Name],
						                DimDate[Day Of Week Name Short]
						            ),
						            DimDate[Fiscal Year Number] = PreviousFiscalYear,
						            DimDate[Fiscal Day Of Year] <= LastDayOfFiscalYearAvailable,
						            DimDate[DateWithSales] = TRUE
						        )
						    RETURN
						        Result
						)

				calculationItem YoYTD =
						VAR ValueCurrentPeriod =
						    IF (
						        [ShowValueForDates],
						        VAR LastDayAvailable =
						            MAX ( DimDate[Fiscal Day Of Year] )
						        VAR LastFiscalYearAvailable =
						            MAX ( DimDate[Fiscal Year Number] )
						        VAR Result =
						            CALCULATE (
						                SELECTEDMEASURE (),
						                ALLEXCEPT (
						                    DimDate,
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short]
						                ),
						                DimDate[Fiscal Day Of Year] <= LastDayAvailable,
						                DimDate[Fiscal Year Number] = LastFiscalYearAvailable
						            )
						        RETURN
						            Result
						    )
						VAR ValuePreviousPeriod =
						    IF (
						        [ShowValueForDates],
						        VAR PreviousFiscalYear =
						            MAX ( DimDate[Fiscal Year Number] ) - 1
						        VAR LastDayOfFiscalYearAvailable =
						            CALCULATE (
						                MAX ( DimDate[Fiscal Day Of Year] ),
						                REMOVEFILTERS (
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short],
						                    DimDate[Day Of Week Iso]
						                ),
						                DimDate[DateWithSales] = TRUE
						            )
						        VAR Result =
						            CALCULATE (
						                SELECTEDMEASURE (),
						                ALLEXCEPT (
						                    DimDate,
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short]
						                ),
						                DimDate[Fiscal Year Number] = PreviousFiscalYear,
						                DimDate[Fiscal Day Of Year] <= LastDayOfFiscalYearAvailable,
						                DimDate[DateWithSales] = TRUE
						            )
						        RETURN
						            Result
						    )
						VAR Result =
						    IF (
						        NOT ISBLANK ( ValueCurrentPeriod ) && NOT ISBLANK ( ValuePreviousPeriod ),
						        ValueCurrentPeriod - ValuePreviousPeriod
						    )
						RETURN
						    Result

				calculationItem 'YoYTD %' =
						VAR ValueCurrentPeriod =
						    IF (
						        [ShowValueForDates],
						        VAR LastDayAvailable =
						            MAX ( DimDate[Fiscal Day Of Year] )
						        VAR LastFiscalYearAvailable =
						            MAX ( DimDate[Fiscal Year Number] )
						        VAR Result =
						            CALCULATE (
						                SELECTEDMEASURE (),
						                ALLEXCEPT (
						                    DimDate,
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short]
						                ),
						                DimDate[Fiscal Day Of Year] <= LastDayAvailable,
						                DimDate[Fiscal Year Number] = LastFiscalYearAvailable
						            )
						        RETURN
						            Result
						    )
						VAR ValuePreviousPeriod =
						    IF (
						        [ShowValueForDates],
						        VAR PreviousFiscalYear =
						            MAX ( DimDate[Fiscal Year Number] ) - 1
						        VAR LastDayOfFiscalYearAvailable =
						            CALCULATE (
						                MAX ( DimDate[Fiscal Day Of Year] ),
						                REMOVEFILTERS (
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short],
						                    DimDate[Day Of Week Iso]
						                ),
						                DimDate[DateWithSales] = TRUE
						            )
						        VAR Result =
						            CALCULATE (
						                SELECTEDMEASURE (),
						                ALLEXCEPT (
						                    DimDate,
						                    DimDate[Day Of Week Name],
						                    DimDate[Day Of Week Name Short]
						                ),
						                DimDate[Fiscal Year Number] = PreviousFiscalYear,
						                DimDate[Fiscal Day Of Year] <= LastDayOfFiscalYearAvailable,
						                DimDate[DateWithSales] = TRUE
						            )
						        RETURN
						            Result
						    )
						VAR Result =
						    IF (
						        NOT ISBLANK ( ValueCurrentPeriod ) && NOT ISBLANK ( ValuePreviousPeriod ),
						        DIVIDE ( ValueCurrentPeriod - ValuePreviousPeriod, ABS ( ValuePreviousPeriod ) )
						    )
						RETURN
						    Result

					formatStringDefinition = "0.0%"

				calculationItem PP =

						VAR _KPI_PD =
						    CALCULATE ( SELECTEDMEASURE (), DATEADD ( DimDate[Date Day], -1, DAY ) )
						VAR _KPI_PW =
						    IF (
						        [ShowValueForDates],
						        SUMX (
						            VALUES ( DimDate[Fiscal Year Week Number] ),
						            VAR CurrentFiscalYearWeekNumber = DimDate[Fiscal Year Week Number]
						            VAR DaysSelected =
