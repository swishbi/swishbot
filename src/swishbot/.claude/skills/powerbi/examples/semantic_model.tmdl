			/// Returns the KPI value aggregated over the last 12 months.
			measure 'KPI LTM' =

					CALCULATE ( [KPI], DATESINPERIOD ( DimDate[Date Day], MAX ( DimDate[Date Day] ), -12, MONTH ) )
				displayFolder: Time Intelligence\Moving annual total growth
				lineageTag: a228b52f-b468-46ce-9423-c58a2d03414e

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Returns the KPI value aggregated over the last 3 full months.
			measure 'KPI L3M' =

					CALCULATE ( [KPI], DATESINPERIOD ( DimDate[Date Day], MAX ( DimDate[Date Day] ), -3, MONTH ) )
				displayFolder: Time Intelligence\Moving annual total growth
				lineageTag: 1f233d82-6e08-40df-a5a2-685d44c037d6

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Average of the KPI over the last 4 weeks.
			measure 'KPI AVG 4W' =

					IF (
					    [ShowValueForDates],
					    VAR LastDay = MAX ( DimDate[Sequential Day Number] )
					    VAR FirstDay = LastDay - 27
					    VAR Period4W =
					        CALCULATETABLE (
					            VALUES ( DimDate[Sequential Day Number] ),
					            ALLEXCEPT (
					                DimDate,
					                DimDate[Day Of Week Name],
					                DimDate[Day Of Week Name Short]
					            ),
					            DimDate[Sequential Day Number] >= FirstDay
					                && DimDate[Sequential Day Number] <= LastDay,
					            DimDate[DateWithSales] = TRUE
					        )
					    VAR Result =
					        CALCULATE (
					            AVERAGEX ( Period4W, [KPI] ),
					            REMOVEFILTERS ( DimDate )
					        )
					    RETURN
					        Result
					)
				displayFolder: Time Intelligence\Moving averages
				lineageTag: 7ae943a4-0d34-4a0c-99e5-b003f0072e4f

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI Total' =

					CALCULATE ( [KPI], ALL ( DimCompany ) )
				displayFolder: Time Intelligence\_Base Measures
				lineageTag: 7bfb867a-070f-4409-b94f-dd8fbc31e2e7

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI Variance' = [KPI] - [KPI Total]
				displayFolder: Time Intelligence\_Base Measures
				lineageTag: 9fed4585-19a3-4664-a848-7728483490cb

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// The central KPI dispatch measure. Resolves the currently selected KPI
			/// from the _PrmKPI field parameter. All time intelligence measures reference
			/// this measure so they automatically work for any selected KPI.
			measure KPI = ```

					SWITCH(
					    SELECTEDVALUE( _PrmKPI[_PrmKPI Fields] ),

					    // ─── Revenue ────────────────────────────────────────────────────────
					    "'_Measures'[Total Revenue]", [Total Revenue],
					    "'_Measures'[Average Order Value]", [Average Order Value],
					    "'_Measures'[Average Daily Revenue]", [Average Daily Revenue],

					    // ─── Orders ─────────────────────────────────────────────────────────
					    "'_Measures'[Order Count]", [Order Count],
					    "'_Measures'[Units Sold]", [Units Sold],

					    // ─── Customers ──────────────────────────────────────────────────────
					    "'_Measures'[Active Customer Count]", [Active Customer Count],
					    "'_Measures'[New Customer Count]", [New Customer Count],
					    "'_Measures'[Customer Retention Rate]", [Customer Retention Rate],

					    // ─── Profitability ──────────────────────────────────────────────────
					    "'_Measures'[Gross Profit]", [Gross Profit],
					    "'_Measures'[Gross Margin %]", [Gross Margin %],
					    "'_Measures'[Net Profit]", [Net Profit],
					    "'_Measures'[Net Margin %]", [Net Margin %],

					    // ─── Fallback ───────────────────────────────────────────────────────
					    BLANK()
					)

					```
				displayFolder: Time Intelligence\_Base Measures
				lineageTag: 6442064b-4ea8-4566-af58-c341771407f0

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Total revenue from all orders.
			measure 'Total Revenue' =

					SUM ( FctOrders[Order Amount] )
				formatString: \$#,0.00;(\$#,0.00);\$#,0.00
				displayFolder: Revenue
				lineageTag: 11111111-1111-1111-1111-111111111111

				annotation PBI_FormatHint = {"currencyCulture":"en-US"}

			/// Average revenue per order.
			measure 'Average Order Value' =

					DIVIDE ( [Total Revenue], [Order Count] )
				formatString: \$#,0.00;(\$#,0.00);\$#,0.00
				displayFolder: Revenue
				lineageTag: 22222222-2222-2222-2222-222222222222

				annotation PBI_FormatHint = {"currencyCulture":"en-US"}

			/// Average daily revenue for the selected period.
			measure 'Average Daily Revenue' =

					DIVIDE (
					    [Total Revenue],
					    DISTINCTCOUNT ( FctOrders[Order Date Dt] )
					)
				formatString: \$#,0.00;(\$#,0.00);\$#,0.00
				displayFolder: Revenue
				lineageTag: 33333333-3333-3333-3333-333333333333

				annotation PBI_FormatHint = {"currencyCulture":"en-US"}

			/// Count of distinct orders.
			measure 'Order Count' =

					COUNTROWS ( FctOrders )
				formatString: #,0
				displayFolder: Orders
				lineageTag: 44444444-4444-4444-4444-444444444444

			/// Total units sold across all order line items.
			measure 'Units Sold' =

					SUM ( FctOrderLineItems[Quantity] )
				formatString: #,0
				displayFolder: Orders
				lineageTag: 55555555-5555-5555-5555-555555555555

			/// Count of distinct customers with at least one order in the selected period.
			measure 'Active Customer Count' =

					DISTINCTCOUNT ( FctOrders[Customer Key] )
				formatString: #,0
				displayFolder: Customers
				lineageTag: 66666666-6666-6666-6666-666666666666

			/// Count of customers whose first order falls within the selected period.
			measure 'New Customer Count' =

					COUNTROWS (
					    FILTER (
					        VALUES ( DimCustomer[Customer Key] ),
					        CALCULATE ( MIN ( FctOrders[Order Date Dt] ) )
					            >= MIN ( DimDate[Date Day] )
					    )
					)
				formatString: #,0
				displayFolder: Customers
				lineageTag: 77777777-7777-7777-7777-777777777777

			/// Percentage of prior-period customers who placed at least one order
			/// in the current period.
			measure 'Customer Retention Rate' =

					VAR CustomersThisPeriod =
					    VALUES ( FctOrders[Customer Key] )
					VAR CustomersPriorPeriod =
					    CALCULATETABLE (
					        VALUES ( FctOrders[Customer Key] ),
					        DATEADD ( DimDate[Date Day], -1, YEAR )
					    )
					VAR RetainedCustomers =
					    INTERSECT ( CustomersThisPeriod, CustomersPriorPeriod )
					RETURN
					    DIVIDE (
					        COUNTROWS ( RetainedCustomers ),
					        COUNTROWS ( CustomersPriorPeriod )
					    )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Customers
				lineageTag: 88888888-8888-8888-8888-888888888888

			/// Total revenue minus total cost of goods sold.
			measure 'Gross Profit' =

					[Total Revenue] - SUM ( FctOrders[Cost Amount] )
				formatString: \$#,0.00;(\$#,0.00);\$#,0.00
				displayFolder: Profitability
				lineageTag: 99999999-9999-9999-9999-999999999999

				annotation PBI_FormatHint = {"currencyCulture":"en-US"}

			/// Gross profit as a percentage of total revenue.
			measure 'Gross Margin %' =

					DIVIDE ( [Gross Profit], [Total Revenue] )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Profitability
				lineageTag: aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa

			/// Total revenue minus all costs (COGS + operating expenses).
			measure 'Net Profit' =

					[Total Revenue] - SUM ( FctOrders[Cost Amount] ) - SUM ( FctOrders[Operating Expense Amount] )
				formatString: \$#,0.00;(\$#,0.00);\$#,0.00
				displayFolder: Profitability
				lineageTag: bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb

				annotation PBI_FormatHint = {"currencyCulture":"en-US"}

			/// Net profit as a percentage of total revenue.
			measure 'Net Margin %' =

					DIVIDE ( [Net Profit], [Total Revenue] )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Profitability
				lineageTag: cccccccc-cccc-cccc-cccc-cccccccccccc

			partition _Measures = calculated
				mode: import
				source = ROW ( "Column", BLANK () )

