				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI to Date' = ```

					CALCULATE (
					    [KPI],
					    FILTER (
					        ALL ( DimDate ),
					        DimDate[Date Day] <= MAX ( DimDate[Date Day] )
					    )
