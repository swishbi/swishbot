						                    DaysSelected,
						                    ALLEXCEPT (
						                        DimDate,
						                        DimDate[Day Of Week Name],
						                        DimDate[Day Of Week Name Short]
						                    )
						                )
						        )
						    )
						RETURN
						    SWITCH (
						        TRUE (),
						        ISINSCOPE ( DimDate[Date Day] ), _KPI_PD,
						        ISINSCOPE ( DimDate[Week Start Date] ), _KPI_PW,
						        ISINSCOPE ( DimDate[Accounting Period Name] ), _KPI_PM,
