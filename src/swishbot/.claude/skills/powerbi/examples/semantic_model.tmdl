				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI DoD %' =

					VAR ValueCurrentPeriod = [KPI]
					VAR ValuePreviousPeriod =
					    CALCULATE ( [KPI], DATEADD ( DimDate[Date Day], -1, DAY ) )
					RETURN
					    DIVIDE ( ValueCurrentPeriod - ValuePreviousPeriod, ValuePreviousPeriod )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: a1b2c3d4-5555-6666-7777-888899990000

			/// A dynamic time-based comparison metric that calculates the percentage change
			/// in KPI values relative to the equivalent prior period, based on the level of
			/// the date hierarchy selected.
			measure 'KPI PoP %' =

					SWITCH (
					    TRUE,
					    ISINSCOPE ( DimDate[Date Day] ), [KPI DoD %],
					    ISINSCOPE ( DimDate[Week Start Date] ), [KPI WoW %],
					    ISINSCOPE ( DimDate[Accounting Period Name] ), [KPI MoM %],
					    ISINSCOPE ( DimDate[Fiscal Quarter Name] ), [KPI QoQ %],
					    ISINSCOPE ( DimDate[Fiscal Year Name] ), [KPI YoY %]
					)
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: 0c373aac-030f-4c49-a93c-9b0581d8697e

			/// A dynamic time intelligence metric that automatically calculates the change
			/// in KPI compared to the equivalent prior period, depending on the level of
			/// the date hierarchy selected in the report.
			measure 'KPI PoP' =

					SWITCH (
					    TRUE,
					    ISINSCOPE ( DimDate[Date Day] ), [KPI DoD],
					    ISINSCOPE ( DimDate[Week Start Date] ), [KPI WoW],
					    ISINSCOPE ( DimDate[Accounting Period Name] ), [KPI MoM],
					    ISINSCOPE ( DimDate[Fiscal Quarter Name] ), [KPI QoQ],
					    ISINSCOPE ( DimDate[Fiscal Year Name] ), [KPI YoY]
					)
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: de1fcb34-f423-48a6-a905-df22868be3dd

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			/// Returns the KPI value from the immediately preceding comparable period,
			/// dynamically resolved based on the current date hierarchy level.
			measure 'KPI PP' =

					SWITCH (
					    TRUE,
					    ISINSCOPE ( DimDate[Date Day] ), CALCULATE ( [KPI], DATEADD ( DimDate[Date Day], -1, DAY ) ),
					    ISINSCOPE ( DimDate[Week Start Date] ), [KPI PW],
					    ISINSCOPE ( DimDate[Accounting Period Name] ), [KPI PM],
					    ISINSCOPE ( DimDate[Fiscal Quarter Name] ), [KPI PQ],
					    ISINSCOPE ( DimDate[Fiscal Year Name] ), [KPI PY]
					)
				displayFolder: Time Intelligence\Period-over-period growth
				lineageTag: 8586420a-7898-4e8b-9ebf-d2c40f9f33fc

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI PYTD' =

					IF (
					    [ShowValueForDates],
					    VAR PreviousFiscalYear = MAX ( DimDate[Fiscal Year Number] ) - 1
					    VAR LastDayOfFiscalYearAvailable =
					        CALCULATE (
					            MAX ( DimDate[Fiscal Day Of Year] ),
					            REMOVEFILTERS (
					                DimDate[Day Of Week Name],
					                DimDate[Day Of Week Name Short],
					                DimDate[Day Of Week Iso]
					            ),
					            DimDate[DateWithSales] = TRUE
					        )
					    VAR Result =
					        CALCULATE (
					            [KPI],
					            ALLEXCEPT (
					                DimDate,
					                DimDate[Day Of Week Name],
					                DimDate[Day Of Week Name Short]
					            ),
					            DimDate[Fiscal Year Number] = PreviousFiscalYear,
					            DimDate[Fiscal Day Of Year] <= LastDayOfFiscalYearAvailable,
					            DimDate[DateWithSales] = TRUE
					        )
					    RETURN
					        Result
					)
				displayFolder: Time Intelligence\Period-to-date growth
				lineageTag: 46394762-1b2a-4dc8-bab9-0ee721d21d91

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI YoYTD' =

					VAR ValueCurrentPeriod = [KPI YTD]
					VAR ValuePreviousPeriod = [KPI PYTD]
					VAR Result =
					    IF (
					        NOT ISBLANK ( ValueCurrentPeriod ) && NOT ISBLANK ( ValuePreviousPeriod ),
					        ValueCurrentPeriod - ValuePreviousPeriod
					    )
					RETURN
					    Result
				displayFolder: Time Intelligence\Period-to-date growth
				lineageTag: f7bdc5de-cabb-4f47-9352-46829f461966

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI YoYTD %' =

					DIVIDE ( [KPI YoYTD], [KPI PYTD] )
				formatString: 0.0%;-0.0%;0.0%
				displayFolder: Time Intelligence\Period-to-date growth
				lineageTag: 56ab74d0-67a9-4773-8624-bd3e829fd430

			measure 'KPI YTD' =

					IF (
					    [ShowValueForDates],
					    VAR LastDayAvailable = MAX ( DimDate[Fiscal Day Of Year] )
					    VAR LastFiscalYearAvailable = MAX ( DimDate[Fiscal Year Number] )
					    VAR Result =
					        CALCULATE (
					            [KPI],
					            ALLEXCEPT ( DimDate, DimDate[Day Of Week Name], DimDate[Day Of Week Name Short] ),
					            DimDate[Fiscal Day Of Year] <= LastDayAvailable,
					            DimDate[Fiscal Year Number] = LastFiscalYearAvailable
					        )
					    RETURN
					        Result
					)
				displayFolder: Time Intelligence\Period-to-date total
				lineageTag: 8dffa2bd-67f9-4dcc-a4f8-ff2307996ab3

				annotation PBI_FormatHint = {"isGeneralNumber":true}

			measure 'KPI QTD' =

					IF (
					    [ShowValueForDates],
					    VAR LastDayAvailable = MAX ( DimDate[Fiscal Day Of Quarter] )
					    VAR LastFiscalYearQuarterAvailable = MAX ( DimDate[Fiscal Year Quarter Number] )
					    VAR Result =
					        CALCULATE (
					            [KPI],
					            ALLEXCEPT ( DimDate, DimDate[Day Of Week Name], DimDate[Day Of Week Name Short] ),
					            DimDate[Fiscal Day Of Quarter] <= LastDayAvailable,
					            DimDate[Fiscal Year Quarter Number] = LastFiscalYearQuarterAvailable
					        )
					    RETURN
					        Result
