# Snowflake credentials (for dlt and dbt)
DESTINATION__SNOWFLAKE__CREDENTIALS__ACCOUNT=
DESTINATION__SNOWFLAKE__CREDENTIALS__DATABASE=
DESTINATION__SNOWFLAKE__CREDENTIALS__WAREHOUSE=
DESTINATION__SNOWFLAKE__CREDENTIALS__ROLE=
DESTINATION__SNOWFLAKE__CREDENTIALS__USER=
DESTINATION__SNOWFLAKE__CREDENTIALS__PASSWORD=

# Power BI (service principal)
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=

# dbt sandbox schema (local dev only)
DBT_SANDBOX_SCHEMA=dbt_yourname

# dbt MCP server (used by Claude Code agents via .mcp.json)
DBT_PROJECT_DIR=transformation
DBT_PATH=.venv/bin/dbt
# DBT_HOST=abc123.us1.dbt.com  # dbt Cloud host — uncomment to enable Cloud features
